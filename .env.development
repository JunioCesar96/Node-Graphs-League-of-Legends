# `npm run dev` pergunta Nativo (padrão) vs Bridge Jade e define proxies.
# Atalhos: npm run dev:native | npm run dev:jade
# Proxy Jade: /api/jade → JADE_BRIDGE_TARGET (só modo Jade)
# VITE_JADE_USE_PROXY=true
# JADE_BRIDGE_TARGET=http://127.0.0.1:8788
# Proxy Ritobin: /api/ritobin → RITOBIN_BRIDGE_TARGET (modo Nativo)
# RITOBIN_BRIDGE_TARGET=http://127.0.0.1:8791
