{
  "name": "node-graphs-lol",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "reconvert:class": "npx vite-node scripts/reconvert-class-pack.ts class",
    "reconvert:ccg": "npx vite-node scripts/reconvert-class-pack.ts ccg",
    "jade-bridge:dev": "node scripts/jade/mock-bridge-server.mjs",
    "ritobin-bridge:dev": "node scripts/ritobin/invoke-server.mjs",
    "jade-export:bintree:build": "cd ../Jade-League-Bin-Editor/src-tauri && cargo build --release --bin jade-export-bintree-json",
    "jade:http-bridge": "cd ../Jade-League-Bin-Editor/src-tauri && cargo run --release --bin jade-http-bridge",
    "jade:tools:check": "cd ../Jade-League-Bin-Editor/src-tauri && cargo check --bins"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^27.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.0.17"
  }
}
