# --- Cliente (VITE_*) ---
# Opção A — URL absoluta do bridge:
# VITE_JADE_BIN_BRIDGE=http://127.0.0.1:8788

# Opção B — em `pnpm dev`, proxy relativo mesmo origem (/api/jade → ver vite.config.ts):
VITE_JADE_USE_PROXY=true

# --- Servidor Vite apenas (copiar para `.env.development.local` ou export no shell) ---
# Para onde o proxy `/api/jade/*` faz forward quando usas Opção B
JADE_BRIDGE_TARGET=http://127.0.0.1:8788

# Grafo BinTree: heurística Hash→ (`VITE_LTK_HASH_AS_EDGE`; omitir = activo neste projeto)
# VITE_LTK_HASH_AS_EDGE=false

# Mock bridge (`npm run jade-bridge:dev`): opcional CLI `jade-export-bintree-json`
# JADE_CONVERT_TREE_BINARY=C:\\...\\target\\release\\jade-export-bintree-json.exe
# JADE_BINTREE_JSON_COMPACT=1

# Ponte Ritobin (`npm run ritobin-bridge:dev`). Omitir `VITE_RITOBIN_USE_PROXY` → herda `VITE_JADE_USE_PROXY` em `vite.config.ts`.
# RITOBIN_BRIDGE_TARGET=http://127.0.0.1:8791
# VITE_RITOBIN_USE_PROXY=false
# Ou URL absoluta sem `/api/ritobin`:
# VITE_RITOBIN_INVOKE_BRIDGE=http://127.0.0.1:8791
